{
  "name": "@australiangreens/ag-arch-rules",
  "version": "1.1.2",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ag-arch-rules": "./dist/bin/init.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./config": {
      "import": "./dist/config.js",
      "types": "./dist/config.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "release": "node scripts/release.js",
    "ship": "pnpm test && pnpm build && pnpm publish --no-git-checks"
  },
  "peerDependencies": {
    "vitest": ">=1.0.0"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "archunit": "^2.4.0",
    "glob": "^13.0.6",
    "madge": "^8.0.0",
    "micromatch": "^4.0.0"
  },
  "devDependencies": {
    "@types/madge": "^5.0.3",
    "@types/micromatch": "^4.0.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.30.3"
}
